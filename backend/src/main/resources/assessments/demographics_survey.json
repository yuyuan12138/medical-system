          "icon": "phone",
          "placeholder": "11位手机号码"
        },
        {
          "id": "demo_class",
          "field": "major",
          "text": "3. 所在班级与专业：",
          "type": "text",
          "icon": "school",
          "placeholder": "例如：计算机学院 软工2601班"
