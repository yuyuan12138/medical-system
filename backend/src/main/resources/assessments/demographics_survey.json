{
  "id": "demographics_survey",
  "title": "个人基本信息核对",
  "subtitle": "新生入学健康与背景档案登记",
  "estimatedMinutes": 8,
  "description": "本问卷包括个人基本资料、一般成长情况及生活健康习惯，请按照您自己的实际情况认真填写。",
  "instructions": "该问卷包括一般资料及一些与心理健康有关的问题。请按照您自己对这些问题的实际看法和经历认真填写。所有问题的答案没有对错之分，您不必有任何顾虑。如果您对某个问题的答案无法确定，请您选择最接近的答案。谢谢合作！",
  "introItems": [
    {
      "icon": "badge",
      "title": "基本信息与就读情况",
      "description": "确认学生基本身份、班级学号与在校联络档案。"
    },
    {
      "icon": "home",
      "title": "成长与家庭背景",
      "description": "涵盖家庭结构、常住地区、父母教育及成长经历。"
    },
    {
      "icon": "vital_signs",
      "title": "健康生活与身心习惯",
      "description": "涉及运动、睡眠、作息、慢性疾病及既往健康服务体验。"
    }
  ],
